---
import BaseLayout from '../layouts/BaseLayout.astro';
import Horarios from '../components/Horarios.astro';
import { content } from '../data/content';
import { faqLd, breadcrumbLd } from '../lib/schema';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
const site = Astro.site?.toString();
const jsonLd = [
  faqLd(content[locale].horarios.items_faq),
  breadcrumbLd(site, [
    { name: 'Parque Calderón', path: '/' },
    { name: 'Horarios', path: '/horarios/' }
  ])
];
---

<BaseLayout
  locale={locale}
  pageKey="horarios"
  title="Horarios del Parque Calderón, Cuenca: acceso, entrada y mejor hora"
  description="Horarios del Parque Calderón en Cuenca, Ecuador: horario de Google Maps, acceso al espacio público, entradas a catedrales y museos, mejor momento y duración de la visita."
  jsonLd={jsonLd}
>
  <Horarios locale={locale} />
</BaseLayout>
