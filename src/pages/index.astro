---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { content } from '../data/content';
import { faqLd, breadcrumbLd, attractionLd } from '../lib/schema';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
const site = Astro.site?.toString();
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Parque Calderón, Cuenca', url: site ? new URL('/', site).toString() : '/' },
  attractionLd(site, locale),
  faqLd(content[locale].faq.items),
  breadcrumbLd(site, [{ name: 'Parque Calderón', path: '/' }])
];
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title="Parque Calderón, Cuenca: cómo llegar, horarios y qué hacer"
  description="Guía del Parque Calderón en Cuenca, Ecuador: cómo llegar, horario 24 h, entrada gratuita, dónde comer, sitios cercanos y consejos de visita en el Centro Histórico."
  jsonLd={jsonLd}
>
  <HomeContent locale={locale} />
</BaseLayout>
