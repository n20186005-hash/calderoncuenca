---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title="Página no encontrada · Parque Calderón, Cuenca"
  description="La página que buscas no existe."
  noIndex={true}
>
  <main class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-6 text-center">
    <p class="sans text-xs font-semibold uppercase tracking-[.28em] text-[#9b4e38]">Error 404</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-[-.04em]">Esta página no existe</h1>
    <p class="mt-5 max-w-md text-lg leading-8 text-black/70">El enlace que seguiste no está disponible. Vuelve a la guía del Parque Calderón en Cuenca.</p>
    <div class="sans mt-8 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="rounded-full bg-[#315849] px-6 py-3 text-white no-underline">Parque Calderón (ES)</a>
      <a href="/en/" class="rounded-full border border-black/20 px-6 py-3 no-underline">Parque Calderón (EN)</a>
    </div>
  </main>
</BaseLayout>
