---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComoLlegar from '../../components/ComoLlegar.astro';
import { content } from '../../data/content';
import { faqLd, breadcrumbLd } from '../../lib/schema';
import type { Locale } from '../../i18n';

const locale: Locale = 'en';
const site = Astro.site?.toString();
const jsonLd = [
  faqLd(content[locale].comoLlegar.items_faq),
  breadcrumbLd(site, [
    { name: 'Parque Calderón', path: '/en/' },
    { name: 'Getting there', path: '/en/how-to-get-there/' }
  ])
];
---

<BaseLayout
  locale={locale}
  pageKey="comoLlegar"
  title="How to Get to Parque Calderón, Cuenca, Ecuador: Transport"
  description="Getting to Parque Calderón in Cuenca, Ecuador: on foot, by taxi, city bus, from Mariscal Lamar airport and the bus terminal. Map, parking advice and FAQs."
  jsonLd={jsonLd}
>
  <ComoLlegar locale={locale} />
</BaseLayout>
