---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Horarios from '../../components/Horarios.astro';
import { content } from '../../data/content';
import { faqLd, breadcrumbLd } from '../../lib/schema';
import type { Locale } from '../../i18n';

const locale: Locale = 'en';
const site = Astro.site?.toString();
const jsonLd = [
  faqLd(content[locale].horarios.items_faq),
  breadcrumbLd(site, [
    { name: 'Parque Calderón', path: '/en/' },
    { name: 'Hours', path: '/en/hours/' }
  ])
];
---

<BaseLayout
  locale={locale}
  pageKey="horarios"
  title="Parque Calderón, Cuenca hours: reopening, access & nearby visits"
  description="Hours and facts about Parque Calderón in Cuenca: October 2026 reopening, Maps hours and separate nearby visits, best time, planning and location."
  jsonLd={jsonLd}
>
  <Horarios locale={locale} />
</BaseLayout>
