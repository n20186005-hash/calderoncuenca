---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Horarios from '../../components/Horarios.astro';
import { content } from '../../data/content';
import { faqLd, breadcrumbLd } from '../../lib/schema';
import type { Locale } from '../../i18n';

const locale: Locale = 'en';
const site = Astro.site?.toString();
const jsonLd = [
  faqLd(content[locale].horarios.items_faq),
  breadcrumbLd(site, [
    { name: 'Parque Calderón', path: '/en/' },
    { name: 'Hours', path: '/en/hours/' }
  ])
];
---

<BaseLayout
  locale={locale}
  pageKey="horarios"
  title="Parque Calderón Hours, Cuenca, Ecuador: Reopening & Visits"
  description="Hours and practical facts for Parque Calderón in Cuenca, Ecuador: October 2026 reopening, Google Maps hours, free public space, and separate cathedral and museum visits."
  jsonLd={jsonLd}
>
  <Horarios locale={locale} />
</BaseLayout>
