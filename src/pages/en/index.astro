---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { content } from '../../data/content';
import { faqLd, breadcrumbLd, attractionLd } from '../../lib/schema';
import type { Locale } from '../../i18n';

const locale: Locale = 'en';
const site = Astro.site?.toString();
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Parque Calderón, Cuenca', url: site ? new URL('/en/', site).toString() : '/en/' },
  attractionLd(site, locale),
  faqLd(content[locale].faq.items),
  breadcrumbLd(site, [{ name: 'Parque Calderón', path: '/en/' }])
];
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title="Parque Calderón, Cuenca, Ecuador: What to See, Hours & Map"
  description="Independent guide to Parque Calderón in Cuenca, Ecuador: October 2026 reopening, how to get there, what to see nearby, where to eat and walking routes through the Historic Center."
  jsonLd={jsonLd}
>
  <HomeContent locale={locale} />
</BaseLayout>
