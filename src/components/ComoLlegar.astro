---
import AccessNote from './AccessNote.astro';
import TopicLinks from './TopicLinks.astro';
import { content } from '../data/content';
import { MAPS_URL } from '../data/site';
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = content[locale].comoLlegar;
const showSpanishCluster = locale === 'es';
const mapHl = locale === 'es' ? 'es' : 'en';
const mapSrc = `https://www.google.com/maps?q=Parque%20Calder%C3%B3n%2C%20Cuenca%2C%20Ecuador&output=embed&hl=${mapHl}&gl=ec`;
---

<main>
  <section class="relative overflow-hidden border-b border-black/10 bg-[#315849] text-white">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <p class="sans mb-6 text-xs font-semibold uppercase tracking-[.28em] text-white/70">{d.eyebrow}</p>
      <h1 class="max-w-3xl text-5xl leading-[.95] font-semibold tracking-[-.04em] md:text-7xl">{d.h1}</h1>
      <p class="mt-6 max-w-2xl text-xl leading-8 text-white/80">{d.intro}</p>
    </div>
  </section>
  <AccessNote locale={locale} />

  <section class="mx-auto max-w-6xl px-6 py-16 grid gap-8 lg:grid-cols-2">
    <div class="space-y-6">
      {d.items.map((it) => <article class="rounded-[2rem] border border-black/10 bg-white/55 p-6"><h2 class="text-2xl">{it.title}</h2><p class="mt-3 leading-7 text-black/75">{it.body}</p></article>)}
    </div>
    <div class="overflow-hidden rounded-[2rem] border border-white/15 bg-[#1d2a25] lg:sticky lg:top-20 self-start">
      <iframe title={d.mapTitle} src={mapSrc} width="100%" height="460" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <a href={MAPS_URL} rel="noopener" class="sans block bg-white/10 px-6 py-4 text-sm text-white no-underline hover:bg-white/15">{d.mapLinkText}</a>
    </div>
  </section>

  {showSpanishCluster && <TopicLinks group="transporte" />}

  {locale === 'en' && (
    <section class="mx-auto max-w-4xl px-6 pb-4">
      <p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">International visitors</p>
      <h2 class="mt-3 text-3xl">Arriving from abroad: what to confirm</h2>
      <p class="mt-4 leading-8 text-black/75">Parque Calderón is in the Historic Center of Cuenca, Ecuador — not Cuenca, Spain. Mariscal Lamar airport and the city bus terminal are the usual arrival points for international travellers; this independent guide does not publish a current journey time, fare, bus line or timetable, so check them with the operator on the day.</p>
      <p class="mt-4 leading-8 text-black/75">The park is public space. The New Cathedral, its terraces and crypts, the Old Cathedral Museum and other venues are separate visits with their own hours, possible admission and payment methods. A 24-hour listing on Google Maps is not an operator-confirmed timetable and does not guarantee lighting, services or night-time safety.</p>
      <ul class="topic-list mt-5">
        <li>Confirm the fare and the legal drop-off point with your driver or ride app before setting off.</li>
        <li>Ask whether taxis, venues and cafés accept card payment; do not assume it.</li>
        <li>Check cathedral and museum opening hours separately from the park.</li>
        <li>Keep the 28 October 2026 municipal reopening as a dated fact, not a permanent access guarantee.</li>
        <li>Allow extra time for the final walk through the Historic Center, especially with luggage.</li>
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-4xl px-6 py-16"><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{d.faqEyebrow}</p><h2 class="mt-3 text-4xl">{d.faqH2}</h2><div class="mt-8 divide-y divide-black/10 border-y border-black/10">{d.items_faq.map(([q, a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-xl">{q}<span class="float-right sans text-black/75 group-open:rotate-45">+</span></summary><p class="mt-3 max-w-3xl leading-7 text-black/75">{a}</p></details>)}</div></section>
</main>
