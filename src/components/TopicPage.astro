---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAPS_URL } from '../data/site';
import {
  TOPIC_GROUP_LABELS,
  GROUP_HUB_LINKS,
  SOURCE_LINKS,
  CHECK_DATE,
  topicPath,
  relatedTopics,
  type TopicContent
} from '../data/topics';
import { articleLd, breadcrumbLd, faqLd, placeLd } from '../lib/schema';

interface Props { topic: TopicContent }
const { topic } = Astro.props;
const site = Astro.site?.toString();
const path = topicPath(topic.slug);
const groupLabel = TOPIC_GROUP_LABELS[topic.group];
const crumbs = [
  { name: 'Parque Calderón', path: '/' },
  { name: groupLabel, path: '/#guias' },
  { name: topic.navTitle, path }
];
const related = relatedTopics(topic);
const hubs = GROUP_HUB_LINKS[topic.group];
const sources = [...new Set(['maps', ...topic.sources])].map((key) => SOURCE_LINKS[key as keyof typeof SOURCE_LINKS]);
const faqPairs: [string, string][] = topic.faqs.map((f) => [f.q, f.a]);
const mapsHref = topic.mapsQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(topic.mapsQuery)}`
  : MAPS_URL;
const isoDate = '2026-11-09';
const jsonLd = [
  articleLd(site, {
    title: topic.h1,
    description: topic.description,
    path,
    dateModified: isoDate,
    mentions: topic.mentions
  }),
  breadcrumbLd(site, crumbs),
  faqLd(faqPairs),
  ...(topic.placeName && topic.placeDesc
    ? [placeLd(site, { name: topic.placeName, description: topic.placeDesc, path })]
    : [])
];
const alternates = [
  { lang: 'es-EC', path },
  { lang: 'x-default', path }
];
const sections = topic.sections.map((s) => ({
  h2: s.h2,
  paragraphs: s.paragraphs,
  bullets: s.bullets ?? [],
  note: s.note ?? ''
}));
---

<BaseLayout
  locale="es"
  pageKey="home"
  title={topic.title}
  description={topic.description}
  canonicalPath={path}
  alternates={alternates}
  langSwitchHref="/en/"
  jsonLd={jsonLd}
>
  <main id="guia">
    <section class="relative overflow-hidden border-b border-black/10 bg-[#315849] text-white">
      <div class="mx-auto max-w-6xl px-6 py-14 lg:py-20">
        <p class="sans text-xs font-semibold uppercase tracking-[.28em] text-white/70">{groupLabel} · Guía independiente</p>
        <h1 class="mt-4 max-w-4xl text-4xl leading-[1.05] font-semibold tracking-[-.03em] md:text-6xl">{topic.h1}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-white/80">{topic.lead}</p>
        <p class="sans mt-7 text-sm text-white/70">Información revisada el {CHECK_DATE} · {topic.priority}</p>
      </div>
    </section>

    <nav class="sans mx-auto max-w-6xl px-6 py-5 text-sm text-black/70" aria-label="Ruta de navegación">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true" class="mr-2">/</span>}
            {i < crumbs.length - 1 ? <a href={c.path} class="text-[#315849] underline">{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </li>
        ))}
      </ol>
    </nav>

    {topic.heroImage && (
      <figure class="mx-auto max-w-4xl px-6 -mb-6">
        <img
          src={topic.heroImage.src}
          alt={topic.heroImage.alt}
          width="1280"
          height="960"
          loading="lazy"
          decoding="async"
          class="w-full rounded-[2rem] border border-black/10 object-cover"
        />
        <figcaption class="sans mt-3 text-sm text-black/60">{topic.heroImage.caption}</figcaption>
      </figure>
    )}

    <div class="mx-auto max-w-4xl px-6 pb-16">
      {sections.map((s) => (
        <section class="mt-12 first:mt-6">
          <h2 class="text-3xl">{s.h2}</h2>
          {s.paragraphs.map((p) => <p class="mt-4 text-lg leading-8 text-black/80">{p}</p>)}
          {s.bullets.length > 0 && <ul class="topic-list mt-5">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
          {s.note.length > 0 && <aside class="topic-note">{s.note}</aside>}
        </section>
      ))}

      <section id="faq" class="mt-16">
        <p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">Preguntas frecuentes</p>
        <h2 class="mt-3 text-4xl">FAQ</h2>
        <div class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {topic.faqs.map((f) => (
            <details class="group py-5">
              <summary class="cursor-pointer list-none text-xl">{f.q}<span class="float-right sans text-black/75 group-open:rotate-45">+</span></summary>
              <p class="mt-3 max-w-3xl leading-7 text-black/75">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="relacionadas" class="mt-16">
        <p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">Seguir leyendo</p>
        <h2 class="mt-3 text-3xl">Guías relacionadas</h2>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {related.map((r) => (
            <a href={topicPath(r.slug)} class="topic-card rounded-3xl border border-black/10 bg-white/55 p-6 no-underline">
              <span class="sans text-xs uppercase tracking-[.16em] text-[#9b4e38]">{TOPIC_GROUP_LABELS[r.group]}</span>
              <span class="mt-2 block text-xl font-semibold">{r.navTitle}</span>
              <span class="mt-2 block text-sm leading-6 text-black/70">{r.card}</span>
            </a>
          ))}
        </div>
        <div class="sans mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {hubs.map((h) => <a href={h.href} class="text-[#315849] underline">{h.label}</a>)}
          <a href="/#guias" class="text-[#315849] underline">Ver todas las guías</a>
          <a href={mapsHref} rel="noopener" class="text-[#315849] underline">Abrir en Google Maps ↗</a>
        </div>
      </section>

      <section id="fuentes" class="mt-16 rounded-[2rem] bg-[#eee6d6] p-7">
        <h2 class="text-2xl">Fuentes y verificación</h2>
        <p class="sans mt-3 text-sm leading-6 text-black/75">Revisado el {CHECK_DATE}. Esta guía no publica precios, horarios de recintos ni nombres de negocios sin verificarlos; las condiciones se confirman en las fuentes oficiales y en el lugar.</p>
        <ul class="sans mt-4 space-y-2 text-sm">
          {sources.map((s) => <li><a href={s.url} rel="noopener" class="text-[#315849] underline">{s.label} ↗</a></li>)}
        </ul>
        <p class="sans mt-6 text-sm leading-6 text-black/75">Guía independiente de viaje. Este sitio no es el sitio oficial del Parque Calderón, del Municipio de Cuenca ni de ninguna institución pública o religiosa. El Parque Calderón forma parte del Centro Histórico inscrito por UNESCO, sin una declaración individual propia.</p>
        <p class="sans mt-4 text-sm"><a href="/" class="text-[#315849] underline">Volver a la guía principal del Parque Calderón</a></p>
      </section>
    </div>
  </main>
</BaseLayout>
