---
import { content } from '../data/content';
import { HERO_IMAGE, MAPS_URL } from '../data/site';
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = content[locale];
const mapHl = locale === 'es' ? 'es' : 'en';
const mapSrc = `https://www.google.com/maps?q=Parque%20Calder%C3%B3n%2C%20Cuenca%2C%20Ecuador&output=embed&hl=${mapHl}&gl=ec`;
---

<main id="inicio">
  <section class="relative overflow-hidden border-b border-black/10">
    <div class="mx-auto grid max-w-6xl items-stretch lg:grid-cols-[1.05fr_.95fr]">
      <div class="px-6 py-16 lg:py-24">
        <p class="sans mb-6 text-xs font-semibold uppercase tracking-[.28em] text-[#9b4e38]">{c.hero.eyebrow}</p>
        <h1 class="max-w-3xl text-5xl leading-[.95] font-semibold tracking-[-.04em] md:text-7xl">{c.hero.h1}</h1>
        <p class="mt-6 max-w-xl text-xl leading-8 text-black/70">{c.hero.subtitle}</p>
        <div class="sans mt-9 flex flex-wrap gap-3 text-sm">
          {c.hero.badges.map((b) => <span class="rounded-full border border-black/15 px-4 py-2">{b}</span>)}
        </div>
      </div>
      <div class="min-h-[460px] bg-[#315849] p-5 lg:p-8">
        <div class="relative h-full overflow-hidden rounded-[2rem] border border-white/20 bg-black/10">
          <img src={HERO_IMAGE} alt="Parque Calderón y la Catedral de la Inmaculada Concepción en Cuenca" class="h-full w-full object-cover" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-6 pt-20 text-white">
            <p class="sans text-xs uppercase tracking-[.2em]">{c.hero.capEyebrow}</p>
            <p class="mt-2 text-lg">{c.hero.capText}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id={c.ids.visita} class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div><p class="sans text-xs font-semibold uppercase tracking-[.24em] text-[#9b4e38]">{c.visita.eyebrow}</p><h2 class="mt-3 text-4xl">{c.visita.h2}</h2></div>
      <div class="text-lg leading-8 text-black/75">
        {c.visita.p.map((para) => <p class="mt-5 first:mt-0">{para}</p>)}
      </div>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.visita.stats.map(([a, b]) => <div class="rounded-3xl border border-black/10 bg-white/45 p-6"><div class="sans text-xs uppercase tracking-[.18em] text-black/50">{a}</div><div class="mt-2 text-2xl">{b}</div></div>)}
    </div>
  </section>

  <div class="rule mx-auto max-w-6xl"></div>

  <section class="mx-auto max-w-6xl px-6 py-16 grid gap-8 lg:grid-cols-3">
    <article class="rounded-[2rem] bg-[#315849] p-8 text-white lg:col-span-2"><p class="sans text-xs uppercase tracking-[.2em] text-white/70">{c.mejorMomento.eyebrow}</p><h2 class="mt-3 text-4xl">{c.mejorMomento.h2}</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">{c.mejorMomento.p}</p></article>
    <article class="rounded-[2rem] border border-black/10 bg-[#c7a45b]/20 p-8"><p class="sans text-xs uppercase tracking-[.2em]">{c.mejorMomento.consejoEyebrow}</p><h3 class="mt-3 text-2xl">{c.mejorMomento.consejoH3}</h3><p class="mt-4 leading-7 text-black/70">{c.mejorMomento.consejoP}</p></article>
  </section>

  <section class="bg-[#1d2a25] text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-2">
      <div><p class="sans text-xs uppercase tracking-[.24em] text-[#c7a45b]">{c.llegar.eyebrow}</p><h2 class="mt-3 text-4xl">{c.llegar.h2}</h2><div class="mt-7 space-y-5 text-white/80 leading-7">{c.llegar.p.map((para) => <p>{para}</p>)}</div></div>
      <div class="overflow-hidden rounded-[2rem] border border-white/15 bg-white/5">
        <iframe title={c.llegar.mapTitle} src={mapSrc} width="100%" height="480" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a href={MAPS_URL} rel="noopener" class="sans block bg-white/10 px-6 py-4 text-sm text-white no-underline hover:bg-white/15">{c.llegar.mapLinkText}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 grid gap-8 lg:grid-cols-2">
    <div class="rounded-[2rem] border border-black/10 p-8"><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{c.entradas.costoEyebrow}</p><h2 class="mt-3 text-3xl">{c.entradas.costoH2}</h2><p class="mt-4 leading-7 text-black/70">{c.entradas.costoP}</p></div>
    <div class="rounded-[2rem] border border-black/10 p-8"><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{c.entradas.parkEyebrow}</p><h2 class="mt-3 text-3xl">{c.entradas.parkH2}</h2><p class="mt-4 leading-7 text-black/70">{c.entradas.parkP}</p></div>
  </section>

  <section id={c.ids.comer} class="mx-auto max-w-6xl px-6 pb-16">
    <div class="flex items-end justify-between gap-6"><div><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{c.comer.eyebrow}</p><h2 class="mt-3 text-4xl">{c.comer.h2}</h2></div><p class="sans hidden max-w-md text-sm text-black/55 md:block">{c.comer.subtitle}</p></div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {c.comer.cards.map(([name, type, desc]) => <article class="rounded-3xl bg-white/55 p-6 border border-black/10"><div class="sans text-xs uppercase tracking-[.18em] text-black/45">{type}</div><h3 class="mt-2 text-2xl">{name}</h3><p class="mt-3 leading-7 text-black/65">{desc}</p></article>)}
    </div>
  </section>

  <section id={c.ids.cerca} class="bg-[#9b4e38] text-white">
    <div class="mx-auto max-w-6xl px-6 py-16"><p class="sans text-xs uppercase tracking-[.2em] text-white/70">{c.cerca.eyebrow}</p><h2 class="mt-3 text-4xl">{c.cerca.h2}</h2><div class="mt-8 grid gap-5 md:grid-cols-3">
      {c.cerca.cards.map(([a, b]) => <article class="rounded-3xl border border-white/20 bg-white/10 p-6"><h3 class="text-2xl">{a}</h3><p class="mt-3 leading-7 text-white/75">{b}</p></article>)}
    </div></div>
  </section>

  <section id={c.ids.faq} class="mx-auto max-w-4xl px-6 py-16"><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{c.faq.eyebrow}</p><h2 class="mt-3 text-4xl">{c.faq.h2}</h2><div class="mt-8 divide-y divide-black/10 border-y border-black/10">{c.faq.items.map(([q, a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-xl">{q}<span class="float-right sans text-black/40 group-open:rotate-45">+</span></summary><p class="mt-3 max-w-3xl leading-7 text-black/65">{a}</p></details>)}</div></section>
</main>
