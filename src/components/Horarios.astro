---
import { content } from '../data/content';
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = content[locale].horarios;
---

<main>
  <section class="relative overflow-hidden border-b border-black/10 bg-[#315849] text-white">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <p class="sans mb-6 text-xs font-semibold uppercase tracking-[.28em] text-white/70">{d.eyebrow}</p>
      <h1 class="max-w-3xl text-5xl leading-[.95] font-semibold tracking-[-.04em] md:text-7xl">{d.h1}</h1>
      <p class="mt-6 max-w-2xl text-xl leading-8 text-white/80">{d.intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {d.cards.map(([a, b]) => <div class="rounded-3xl border border-black/10 bg-white/55 p-6"><div class="sans text-xs uppercase tracking-[.18em] text-[#9b4e38]">{a}</div><div class="mt-2 text-lg leading-7 text-black/75">{b}</div></div>)}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-16"><p class="sans text-xs uppercase tracking-[.2em] text-[#9b4e38]">{d.faqEyebrow}</p><h2 class="mt-3 text-4xl">{d.faqH2}</h2><div class="mt-8 divide-y divide-black/10 border-y border-black/10">{d.items_faq.map(([q, a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-xl">{q}<span class="float-right sans text-black/40 group-open:rotate-45">+</span></summary><p class="mt-3 max-w-3xl leading-7 text-black/65">{a}</p></details>)}</div></section>
</main>
